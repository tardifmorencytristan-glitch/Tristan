{
    "schema": "tristan.residual_operator_learning.release.r1",
    "version": "1.1.1",
    "release": "CAUSAL_SHADOW_NO_ACTION_BOUNDED_RUNPATH",
    "purpose": "Learn residual-signature to operator-path outcomes, suppress repeatedly neutral work with bounded revalidation cooldowns, and consume eligible RUN_PATH recommendations only when every token maps to an existing allowlisted local action.",
    "entrypoints": {
        "watcher": "watcher.pyw",
        "learner": "learner.pyw"
    },
    "modes": [
        "SHADOW_ONLY_CAUSAL",
        "NO_ACTION_COOLDOWN",
        "BOUNDED_RUN_PATH_CONSUMPTION"
    ],
    "gates": {
        "run_path": {
            "min_attempts": 3,
            "requires_improved_episode": true,
            "evidence_score_gt": 0,
            "residual_gain_gt": 0
        },
        "no_action_cooldown": {
            "min_attempts": 3,
            "improved_eq": 0,
            "worsened_eq": 0,
            "failed_eq": 0,
            "neutral_gte": 3,
            "residual_gain_eq": 0,
            "cooldown_seconds": 600
        }
    },
    "invariants": [
        "OperationalPASS!=ResidualImprovement",
        "Correlation!=CausalCredit",
        "ModelEpochChange=>ArchiveAndReset",
        "ShadowBeforeInfluence",
        "NO_ACTION_admissible",
        "RightToLose",
        "RightToDie",
        "LearnedPathDoesNotExpandAuthority",
        "UnknownRunPath=>ExistingFallback"
    ],
    "rollback": "Restore previous watcher/learner from local archive or Git history.",
    "authority": "Local user-scope only; no privilege escalation.",
    "materializer": "materialize.pyw",
    "run_path_runtime": {
        "allowlisted_actions": [
            "morph",
            "wave",
            "worker"
        ],
        "unknown_action": "FALLBACK_EXISTING_BEHAVIOR",
        "requires_eligible_to_influence": true
    }
}