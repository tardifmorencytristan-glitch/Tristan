{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardifmorencytristan-glitch/Tristan/schemas/tristan-object.schema.json",
  "title": "TristanObject",
  "type": "object",
  "required": ["id", "kind", "title", "status", "summary"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["IDEA", "PROVISIONAL", "HOLD", "SUPPORTED", "MEASURED", "VERIFIED_ENGINEERING", "CLOSED", "REJECTED", "SUPERSEDED", "RESIDUAL", "UNAVAILABLE"]
    },
    "summary": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "canonical_url": {"type": ["string", "null"]},
    "exact_url": {"type": ["string", "null"]},
    "version_hash": {"type": ["string", "null"]},
    "evidence_urls": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "frontiers": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
